# Copy this file to .env and fill in real values. Never commit .env.

# --- LLM ---
# Primary: Google Gemini (15 RPM free). Fallback: Mistral activates on 429/5xx.
GEMINI_API_KEY=
MISTRAL_API_KEY=

# --- Web Search ---
# Tavily: purpose-built for RAG, 1,000 searches/month free — https://tavily.com
TAVILY_API_KEY=

# --- Database ---
# MongoDB Atlas M0 free cluster — https://cloud.mongodb.com
MONGODB_URI=

# --- Auth ---
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
SESSION_SECRET=

# --- Server ---
PORT=5000
NODE_ENV=development
API_BASE_URL=http://localhost:5000
FRONTEND_URL=http://localhost:3000

# --- Rate Limiting (tuned for Gemini free tier: 15 RPM) ---
LLM_MAX_RPM=14
LLM_BACKOFF_BASE_MS=4000
LLM_RETRY_MAX=3

# --- Crawling ---
CRAWL_MAX_PAGES=15
CRAWL_TIMEOUT_MS=10000
